# SignalDesk Frontend Environment Variables

# The base URL of your deployed SignalDesk backend API
# In production, set this to your hosted backend URL (e.g. https://api.signaldesk.app or https://your-backend.onrender.com)
# When left empty, defaults to http://localhost:3001 for local development
VITE_API_URL=https://api.signaldesk.app
